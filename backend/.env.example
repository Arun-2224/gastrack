PORT=5001
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gastrack?retryWrites=true&w=majority
# For Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/gastrack
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
